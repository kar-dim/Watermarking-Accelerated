<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Watermarking SIMD level">
    <WatermarkingSimd Condition="'$(WatermarkingSimd)' == ''">AVX2</WatermarkingSimd>
    <WatermarkingInstructionSet Condition="'$(WatermarkingSimd)' == 'AVX512'">AdvancedVectorExtensions512</WatermarkingInstructionSet>
    <WatermarkingInstructionSet Condition="'$(WatermarkingSimd)' != 'AVX512'">AdvancedVectorExtensions2</WatermarkingInstructionSet>
    <WatermarkingArch Condition="'$(WatermarkingSimd)' == 'AVX512'">/arch:AVX512</WatermarkingArch>
    <WatermarkingArch Condition="'$(WatermarkingSimd)' != 'AVX512'">/arch:AVX2</WatermarkingArch>
    <WatermarkingClangSimdFlags Condition="'$(WatermarkingSimd)' == 'AVX512'">-mavx512f -mavx512cd -mavx512bw -mavx512dq -mavx512vl -mfma -mf16c</WatermarkingClangSimdFlags>
    <WatermarkingClangSimdFlags Condition="'$(WatermarkingSimd)' != 'AVX512'">-mavx2 -mfma -mf16c</WatermarkingClangSimdFlags>
    <WatermarkingOutputSuffix Condition="'$(WatermarkingSimd)' == 'AVX512'">_AVX512</WatermarkingOutputSuffix>
    <OutDir Condition="'$(WatermarkingSimd)' == 'AVX512'">$(MSBuildThisFileDirectory)$(Platform)\$(Configuration)_AVX512\</OutDir>
    <IntDir Condition="'$(WatermarkingSimd)' == 'AVX512'">$(Platform)\$(Configuration)_AVX512\</IntDir>
  </PropertyGroup>
  <PropertyGroup Label="Watermarking shared paths">
    <WatermarkingRoot>$(MSBuildThisFileDirectory)</WatermarkingRoot>
    <WatermarkingLibraryOutputDirectory>$(WatermarkingRoot)$(Platform)\lib\$(Configuration)$(WatermarkingOutputSuffix)\</WatermarkingLibraryOutputDirectory>
    <WatermarkingCoreDir>$(WatermarkingRoot)Watermarking-Core\</WatermarkingCoreDir>
    <WatermarkingPublicIncludeDirectories>$(WatermarkingCoreDir)include</WatermarkingPublicIncludeDirectories>
    <WatermarkingImageIncludeDirectories>$(WatermarkingCoreDir)libs\CImg;$(WatermarkingCoreDir)libs\zlib\include;$(WatermarkingCoreDir)libs\libpng\include;$(WatermarkingCoreDir)libs\libjpeg\include;$(WatermarkingCoreDir)libs\libwebp\include;$(WatermarkingCoreDir)libs\libtiff\include</WatermarkingImageIncludeDirectories>
    <WatermarkingMediaIncludeDirectory>$(WatermarkingCoreDir)libs\ffmpeg\include</WatermarkingMediaIncludeDirectory>
    <WatermarkingThirdPartyLibraryDirectories>$(WatermarkingCoreDir)libs\zlib\lib;$(WatermarkingCoreDir)libs\libpng\lib;$(WatermarkingCoreDir)libs\libjpeg\lib;$(WatermarkingCoreDir)libs\libwebp\lib;$(WatermarkingCoreDir)libs\libtiff\lib;$(WatermarkingCoreDir)libs\ffmpeg\lib</WatermarkingThirdPartyLibraryDirectories>
    <WatermarkingMediaDependencies>avutil.lib;avformat.lib;swscale.lib;avcodec.lib;avfilter.lib</WatermarkingMediaDependencies>
    <WatermarkingReleaseImageDependencies>zlib.lib;libpng16.lib;jpeg.lib;libwebp.lib;tiff.lib</WatermarkingReleaseImageDependencies>
    <WatermarkingDebugImageDependencies>zlibd.lib;libpng16d.lib;jpeg.lib;libwebp.lib;tiff.lib</WatermarkingDebugImageDependencies>
  </PropertyGroup>

  <ItemDefinitionGroup Label="Watermarking shared compiler defaults">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- windows.h without min/max macros and without the rarely used parts (winsock, COM, shell...), for every project -->
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
