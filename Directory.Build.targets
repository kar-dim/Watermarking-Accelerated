<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WatermarkingRuntimeDestination>$(TargetDir)</WatermarkingRuntimeDestination>
    <WatermarkingRuntimeDestination Condition="'$(MSBuildProjectName)' == 'Watermarking-UI'">$(OutDir)Watermarking-UI\</WatermarkingRuntimeDestination>
    <WatermarkingFormatOnBuild Condition="'$(WatermarkingFormatOnBuild)' == ''">true</WatermarkingFormatOnBuild>
    <WatermarkingCrtSubDir Condition="$(Configuration.Contains('Debug'))">debug_nonredist\x64\Microsoft.VC$(PlatformToolsetVersion).DebugCRT</WatermarkingCrtSubDir>
    <WatermarkingCrtSubDir Condition="!$(Configuration.Contains('Debug'))">x64\Microsoft.VC$(PlatformToolsetVersion).CRT</WatermarkingCrtSubDir>
  </PropertyGroup>

  <Target Name="FormatWatermarkingSources"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(WatermarkingFormatOnBuild)' == 'true'">
    <Message Importance="high" Text="Formatting $(MSBuildProjectName) sources with repository clang-format.exe" />
    <Exec Command="call &quot;$(WatermarkingRoot)format.bat&quot; &quot;$(ProjectDir).&quot;" />
  </Target>

  <ItemGroup Condition="'$(ConfigurationType)' == 'Application'">
    <WatermarkingLicenseFile Include="$(WatermarkingRoot)LICENSES\README.md" />
    <WatermarkingLicenseFile Include="$(WatermarkingRoot)LICENSES\Common\**\*">
      <LicenseSubdirectory>Common\%(RecursiveDir)</LicenseSubdirectory>
    </WatermarkingLicenseFile>
    <WatermarkingLicenseFile Include="$(WatermarkingRoot)LICENSES\Qt\**\*" Exclude="$(WatermarkingRoot)LICENSES\Qt\MESA_LICENSE.txt" Condition="'$(MSBuildProjectName)' == 'Watermarking-UI'">
      <LicenseSubdirectory>Qt\%(RecursiveDir)</LicenseSubdirectory>
    </WatermarkingLicenseFile>
    <WatermarkingLicenseFile Include="$(WatermarkingRoot)LICENSES\Eigen\**\*" Condition="$(Configuration.StartsWith('EIGEN_'))">
      <LicenseSubdirectory>Eigen\%(RecursiveDir)</LicenseSubdirectory>
    </WatermarkingLicenseFile>
    <WatermarkingLicenseFile Include="$(WatermarkingRoot)LICENSES\OpenCL\**\*" Condition="$(Configuration.StartsWith('OPENCL_'))">
      <LicenseSubdirectory>OpenCL\%(RecursiveDir)</LicenseSubdirectory>
    </WatermarkingLicenseFile>
    <WatermarkingLicenseFile Include="$(WatermarkingRoot)LICENSES\CUDA\**\*" Condition="$(Configuration.StartsWith('CUDA_'))">
      <LicenseSubdirectory>CUDA\%(RecursiveDir)</LicenseSubdirectory>
    </WatermarkingLicenseFile>
    <WatermarkingRuntimeFile Include="$(WatermarkingCoreDir)libs\ffmpeg\bin\*.dll" />
    <WatermarkingRuntimeFile Include="$(WatermarkingCoreDir)libs\zlib\bin\zlib1.dll" />
    <WatermarkingRuntimeFile Include="$(WatermarkingCoreDir)libs\libjpeg\bin\jpeg62.dll" />
    <WatermarkingRuntimeFile Include="$(WatermarkingCoreDir)libs\libtiff\bin\tiff.dll" />
    <WatermarkingRuntimeFile Include="$(WatermarkingCoreDir)libs\libpng\bin\libpng16d.dll" Condition="$(Configuration.Contains('Debug'))" />
    <WatermarkingRuntimeFile Include="$(WatermarkingCoreDir)libs\libpng\bin\libpng16.dll" Condition="!$(Configuration.Contains('Debug'))" />
    <WatermarkingRuntimeFile Include="$(CUDA_PATH)\bin\x64\nvjpeg64_*.dll" Condition="$(Configuration.StartsWith('CUDA_'))" />
    <WatermarkingRuntimeFile Include="$(LLVMInstallDir)\x64\bin\libomp.dll" Condition="$(Configuration.StartsWith('EIGEN_')) and Exists('$(LLVMInstallDir)\x64\bin\libomp.dll')" />
    <WatermarkingRuntimeFile Include="$(LLVMInstallDir)\bin\libomp.dll" Condition="$(Configuration.StartsWith('EIGEN_')) and !Exists('$(LLVMInstallDir)\x64\bin\libomp.dll') and Exists('$(LLVMInstallDir)\bin\libomp.dll')" />
    <WatermarkingRuntimeFile Include="$(VCInstallDir)Redist\MSVC\$(VCToolsRedistVersion)\$(WatermarkingCrtSubDir)\*.dll" Condition="Exists('$(VCInstallDir)Redist\MSVC\$(VCToolsRedistVersion)\$(WatermarkingCrtSubDir)')" />
    <WatermarkingRuntimeFile Include="$(VCInstallDir)Redist\MSVC\$(VCToolsRedistVersion)\x64\Microsoft.VC$(PlatformToolsetVersion).OpenMP\vcomp140.dll" Condition="!$(Configuration.Contains('Debug')) and !$(Configuration.StartsWith('EIGEN_')) and Exists('$(VCInstallDir)Redist\MSVC\$(VCToolsRedistVersion)\x64\Microsoft.VC$(PlatformToolsetVersion).OpenMP\vcomp140.dll')" />
    <WatermarkingSampleFile Include="$(WatermarkingRoot)samples\**\*" Exclude="$(WatermarkingRoot)samples\videos\**\*" Condition="'$(MSBuildProjectName)' == 'Watermarking-CLI' or '$(MSBuildProjectName)' == 'Watermarking-Core-tests'" />
  </ItemGroup>

  <ItemDefinitionGroup Condition="'$(ConfigurationType)' == 'Application'">
    <Manifest>
      <AdditionalManifestFiles>$(WatermarkingRoot)utf8.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>

  <Target Name="CopyWatermarkingRuntimeFiles" AfterTargets="Build" Condition="'$(ConfigurationType)' == 'Application'">
    <MakeDir Directories="$(WatermarkingRuntimeDestination)" />
    <Copy SourceFiles="@(WatermarkingRuntimeFile)" DestinationFolder="$(WatermarkingRuntimeDestination)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WatermarkingRuntimeFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="'$(WatermarkingRuntimeDestination)' != '$(TargetDir)'" />
    <Copy SourceFiles="$(WatermarkingRoot)LICENSE" DestinationFolder="$(WatermarkingRuntimeDestination)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(WatermarkingRoot)THIRD_PARTY_NOTICES.md" DestinationFolder="$(WatermarkingRuntimeDestination)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WatermarkingLicenseFile)" DestinationFiles="@(WatermarkingLicenseFile->'$(WatermarkingRuntimeDestination)licenses\%(LicenseSubdirectory)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WatermarkingSampleFile)"
          DestinationFiles="@(WatermarkingSampleFile->'$(TargetDir)samples\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(WatermarkingSampleFile)' != ''" />
    <Copy SourceFiles="$(WatermarkingRoot)Watermarking-UI\assets\fonts\OFL.txt" DestinationFolder="$(WatermarkingRuntimeDestination)licenses\SofiaSans" SkipUnchangedFiles="true" Condition="'$(MSBuildProjectName)' == 'Watermarking-UI'" />
  </Target>
</Project>
